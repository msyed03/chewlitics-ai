USDA_API_KEY=your_real_api_key_here

# Optional: enables real image-based food recognition through Hugging Face.
# Without this token, the image scanner still works in demo mode using filename fallback.
HF_API_TOKEN=
HF_FOOD_MODEL=nateraw/food
FOOD_VISION_MIN_SCORE=0.15

# NUTRITION CACHE
# Successful USDA lookups are cached locally in backend/data/usda_nutrition_cache.json.
# This lets newly detected foods work faster next time without another USDA request.
