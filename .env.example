# Backend environment variables
# Copy this to .env in the backend/ directory

# USDA FoodData Central API Key
# Get one free at: https://fdc.nal.usda.gov/api-key-signup
# For MVP, you can use DEMO_KEY to test (limited requests)
USDA_API_KEY=DEMO_KEY

# Database URL (default is SQLite)
DATABASE_URL=sqlite:///./chewlitics.db

# Frontend environment variables
# Copy this to .env.local in the frontend/ directory

REACT_APP_API_URL=http://localhost:8000

# Optional: enables real image-based food recognition through Hugging Face.
# Without this token, the image scanner still works in demo mode using filename fallback.
HF_API_TOKEN=
HF_FOOD_MODEL=nateraw/food
FOOD_VISION_MIN_SCORE=0.15

# Nutrition cache note:
# Successful USDA lookups are cached locally in backend/data/usda_nutrition_cache.json.
