# Backend environment variables
# Copy this to .env in the backend/ directory

# USDA FoodData Central API Key
# Get one free at: https://fdc.nal.usda.gov/api-key-signup
# For MVP, you can use DEMO_KEY to test (limited requests)
USDA_API_KEY=DEMO_KEY

# Database URL (default is SQLite)
DATABASE_URL=sqlite:///./chewlitics.db

# Frontend environment variables
# Copy this to .env.local in the frontend/ directory

REACT_APP_API_URL=http://localhost:8000
